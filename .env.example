# Local development database (docker-compose.yml).
# Copy to .env — Prisma reads .env, not .env.local. Adjust if you changed the
# credentials in docker-compose.yml.
DATABASE_URL="postgresql://mapcanva:mapcanva@localhost:5432/mapcanva?schema=public"

# Signs the session cookie. Generate one with: npx auth secret
AUTH_SECRET="dev-only-secret-change-me-in-any-real-deployment"

# The single seeded account (MC-043). The seed refuses to run in production.
SEED_ADMIN_EMAIL="admin"
SEED_ADMIN_PASSWORD="admin"

# MinIO (docker-compose.yml) — archives raw import downloads (MC-061). The
# worker service in Docker sets these itself (pointing at the `minio`
# hostname); these defaults are only for running an import script by hand
# on the host, via the port docker-compose publishes to localhost.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="mapcanva"
MINIO_SECRET_KEY="mapcanva123"
MINIO_BUCKET="mapcanva-imports"

# NASA FIRMS (MC-052) — free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Server-side only; the fire hotspots layer is disabled without it.
FIRMS_MAP_KEY=""
